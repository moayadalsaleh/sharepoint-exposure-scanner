<Window x:Class="SharePoint.Cleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharePoint.Cleaner.App"
        mc:Ignorable="d"
        Title="SharePoint Cleaner - MVP"
        Height="680"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="SharePoint Cleaner" />

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="34"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Width="130"
                    Height="34"
                    FontSize="14"
                    Content="Run Scan"
                    Command="{Binding ScanCommand}" />
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Security Scan">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Outcome}" Value="Exposed">
                                        <Setter Property="Background" Value="#FFFDECEA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding CheckId}" Width="80" />
                            <DataGridTextColumn Header="Check" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="90" />
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="90" />
                            <DataGridTextColumn Header="Access scope" Binding="{Binding Scope}" Width="140" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="70" />
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

                    <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="14" Background="#FFFAFAFA">
                        <Grid>
                            <TextBlock Foreground="Gray"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Text="Run a scan and select a check to see the evidence, what it means and how to fix it.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelectedResult, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="{Binding SelectedResult.CheckId, Mode=OneWay}" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding SelectedResult.Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <Border CornerRadius="10" Padding="10,2" Margin="12,0,0,0" Background="#FF607D8B">
                                            <TextBlock Foreground="White" FontWeight="SemiBold"
                                                       Text="{Binding SelectedResult.Outcome}" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF607D8B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedResult.Outcome}" Value="Exposed">
                                                            <Setter Property="Background" Value="#FFC62828" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedResult.Outcome}" Value="Secured">
                                                            <Setter Property="Background" Value="#FF2E7D32" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border CornerRadius="10" Padding="10,2" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF607D8B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedResult.Scope}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedResult.Scope}" Value="Public (anonymous)">
                                                            <Setter Property="Background" Value="#FFC62828" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedResult.Scope}" Value="Authenticated only">
                                                            <Setter Property="Background" Value="#FFF9A825" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="SemiBold"
                                                       Text="{Binding SelectedResult.Scope}" />
                                        </Border>
                                        <Border CornerRadius="10" Padding="10,2" Margin="8,0,0,0" Background="#FF607D8B">
                                            <TextBlock Foreground="White" FontWeight="SemiBold"
                                                       Text="{Binding SelectedResult.RiskLevel, StringFormat='Risk: {0}'}" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF607D8B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedResult.RiskLevel}" Value="High">
                                                            <Setter Property="Background" Value="#FFE65100" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedResult.RiskLevel}" Value="Critical">
                                                            <Setter Property="Background" Value="#FFB71C1C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedResult.RiskLevel}" Value="Medium">
                                                            <Setter Property="Background" Value="#FFF9A825" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="Evidence (what the scan found)" />
                                            <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Text="{Binding SelectedResult.Evidence}" />
                                            <TextBlock FontWeight="SemiBold" Text="Endpoint tested" />
                                            <TextBox Margin="0,4,0,10" IsReadOnly="True" TextWrapping="Wrap"
                                                     FontFamily="Consolas" Background="Transparent" BorderThickness="0"
                                                     Text="{Binding SelectedResult.Endpoint, Mode=OneWay}" />
                                            <TextBlock FontWeight="SemiBold" Text="Recommendation" />
                                            <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Text="{Binding SelectedResult.Recommendation}" />
                                            <TextBlock Foreground="Gray">
                                                <Run Text="HTTP status: " /><Run Text="{Binding SelectedResult.StatusCode, Mode=OneWay, TargetNullValue='n/a'}" />
                                                <Run Text="  |  Duration: " /><Run Text="{Binding SelectedResult.Duration, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="What is the issue" />
                                            <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Text="{Binding SelectedGuidance.Summary}" />
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="Why it matters" />
                                            <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Text="{Binding SelectedGuidance.WhyItMatters}" />
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="How to fix" />
                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedGuidance.HowToFix}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding StringFormat='•  {0}'}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="Related Microsoft documentation" />
                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedGuidance.References}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                                            <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                                                       Text="Links are general Microsoft guidance related to this issue. The explanation text is this tool's own summary." />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Explorer">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Orientation="Horizontal">
                        <Button Width="130" Height="30" Margin="0,0,8,0" Content="Load Site Tree" Command="{Binding LoadSiteTreeCommand}" />
                        <CheckBox VerticalAlignment="Center" Margin="0,0,20,0" Content="Expand all" IsChecked="{Binding ExpandAllSites}" />
                        <TextBlock VerticalAlignment="Center" Text="Max items" Margin="0,0,8,0" />
                        <TextBox Width="70" Height="30" VerticalContentAlignment="Center" Text="{Binding ItemsTop, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Min Id" Margin="14,0,8,0" />
                        <TextBox Width="70" Height="30" VerticalContentAlignment="Center" Text="{Binding ItemsMinId, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Width="100" Height="30" Margin="14,0,0,0" Content="Reload Lists" Command="{Binding LoadListsCommand}" />
                        <Button Width="100" Height="30" Margin="8,0,0,0" Content="Reload Items" Command="{Binding LoadListItemsCommand}" />
                    </WrapPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="1. Sites">
                            <TabControl>
                                <TabItem Header="Grid (click a header to sort)">
                                    <DataGrid AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserSortColumns="True"
                                              HeadersVisibility="Column"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              ItemsSource="{Binding SiteRows}"
                                              SelectedItem="{Binding SelectedSiteNode, Mode=TwoWay}">
                                        <DataGrid.Resources>
                                            <Style x:Key="NumRight" TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Site" Binding="{Binding Title}" Width="170" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                                            <DataGridTextColumn Header="Lists" Binding="{Binding OwnListCount}" Width="60" ElementStyle="{StaticResource NumRight}" />
                                            <DataGridTextColumn Header="Items" Binding="{Binding OwnItemCount, StringFormat=N0}" Width="90" ElementStyle="{StaticResource NumRight}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Tree">
                                    <TreeView ItemsSource="{Binding SiteNodes}"
                                              SelectedItemChanged="SiteTree_SelectedItemChanged">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded"
                                                        Value="{Binding DataContext.ExpandAllSites, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Url}">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding CountText}" Foreground="#1F6FB2" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </TabItem>
                            </TabControl>
                        </GroupBox>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                        <GroupBox Grid.Column="2" Header="2. Lists of selected site">
                            <DataGrid AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      ItemsSource="{Binding Lists}"
                                      SelectedItem="{Binding SelectedList, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Count" Binding="{Binding ItemCount}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <GroupBox Header="3. List items" Margin="0,0,0,4">
                                <DataGrid AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ListItems}"
                                          SelectedItem="{Binding SelectedListItem, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" />
                                        <DataGridTextColumn Header="FileRef" Binding="{Binding FileRef}" Width="220" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="140" />
                                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="140" />
                                        <DataGridTextColumn Header="Preview" Binding="{Binding Preview}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="Item fields" Margin="0,4,0,0">
                                <DataGrid AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ItemFields}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="200" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="10"
                Background="#F2F4F7"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusText}" FontSize="13" />
        </Border>
    </Grid>
</Window>
